FROM node:22.18.0-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
COPY packages ./packages
RUN npm ci --ignore-scripts && npm run build --workspace=packages/cli

FROM node:22.18.0-bookworm-slim
WORKDIR /app
COPY --from=build --chown=node:node /app/packages/cli/dist ./dist
COPY --from=build --chown=node:node /app/packages/cli/package.json ./package.json
USER node
EXPOSE 8080
CMD ["node", "dist/packages/mcp/bin/trenchscope-http.mjs"]
