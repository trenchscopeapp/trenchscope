{
  "version": "0.1.0",
  "updated": "2026-10-09",
  "owner": "maintainers",
  "status": "draft-unreviewed",
  "provenance": "Drafted by the maintainers (task-1287 narrative lane) from the symbols/names/descriptions in input-t0.json plus common memecoin themes. Every term list is a JUDGEMENT; the maintainers own it. Weekly review (see NARRATIVE-BOARD.md §6). Nothing in here is a fact about a live token.",
  "match": {
    "field_weights": {
      "symbol": 3,
      "name": 2,
      "description": 1
    },
    "primary_rule": "theme with the highest summed field weight of its matched terms; tie -> earlier theme in this list (list order is the priority order)",
    "tokenization": "lowercase; '$' stripped; words split on anything that is not a letter or digit; `terms` match whole words (multi-word terms match as a phrase); `stems` are regexes run on the lowercase raw string (symbol, name, description separately)"
  },
  "scoring": {
    "formula": "score = 100 * (w_vol*V + w_pace*P + w_chg*C + w_new*N + w_breadth*B)  where V = sqrt(vol_1h / max vol_1h over ranked narratives); P = clamp(pace_mature/pace_cap,0,1) using tokens >= 24h old (pace = vol_1h / (vol_24h/24)), P = pace_neutral when fewer than 2 mature tokens; C = clamp((median chg_1h over liquid tokens + chg_floor)/(chg_floor+chg_ceiling),0,1); N = clamp(new_24h_unique/new_cap,0,1) where new_24h_unique counts distinct symbols among launches <= 24h old (a copycat wave of one name counts once); B = share of liquid tokens with chg_1h > 0. liquid = liquidity_usd >= runner_min_liquidity_usd. Narratives with fewer than min_tokens_to_rank tokens or min_liquid_tokens_to_rank liquid tokens are shown but not scored. With --window 24h, V uses vol_24h and C uses median chg_24h.",
    "weights": {
      "w_vol": 0.3,
      "w_pace": 0.2,
      "w_chg": 0.25,
      "w_new": 0.15,
      "w_breadth": 0.1
    },
    "pace_cap": 4,
    "pace_neutral": 0.25,
    "chg_floor": 50,
    "chg_ceiling": 50,
    "new_cap": 10,
    "min_tokens_to_rank": 3,
    "min_liquid_tokens_to_rank": 2,
    "runner_min_liquidity_usd": 10000,
    "runners_per_narrative": 3,
    "unclassified_is_ranked": false
  },
