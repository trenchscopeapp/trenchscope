NODE) { if (node.parentElement) hideShortcut(node.parentElement); return; }\r\n    if (!(node instanceof Element || node instanceof ShadowRoot)) return;\r\n    if (node instanceof Element) {\r\n      if (node.closest('#root, dialog, [role=\"dialog\"], wallet-dialog')) return;\r\n      hideShortcut(node);\r\n      if (node.shadowRoot) watch(node.shadowRoot);\r\n    }\r\n    for (var child of node.children) scan(child);\r\n  }\r\n  function watch(root) {\r\n    if (observed.has(root)) return;\r\n    observed.add(root);\r\n    new MutationObserver(function (records) {\r\n      for (var record of records) {\r\n        if (record.type === 'characterData') scan(record.target);\r\n        else for (var node of record.addedNodes) scan(node);\r\n      }\r\n    }).observe(root, { childList: true, subtree: true, characterData: true });\r\n    if (root === document.documentElement) { if (document.body) scan(document.body); }\r\n    else scan(root);\r\n  }\r\n  watch(document.documentElement);\r\n})();\r\n\r\n</script>\r\n    <script>\r\n      // Every fresh visit shows the welcome screen, including returning players.\r\n      // Start the title download before the app bundle and larger scene artwork.\r\n      (function () {\r\n        var mobile = innerWidth <= 700 || matchMedia('(pointer: coarse)').matches ||\r\n          new URLSearchParams(location.search).get('view') === 'mobile' || /Android|iPhone|iPad|iPod/i.test(navigator.userAgent) ||\r\n          (navigator.maxTouchPoints > 0 && Math.min(screen.width, screen.height) > 0 && Math.min(screen.width, screen.height) <= 700);\r\n        var hour = new Date().getHours(), time = hour >= 6 && hour < 17 ? 'day' : hour >= 17 && hour < 20 ? 'sunset' : 'night';\r\n        var art = 'welcome-' + (mobile ? 'phone' : 'desktop') + '-' + time + '-notes-v197.webp';\r\n        var title = document.createElement('link'); title.rel = 'preload'; title.as = 'image'; title.href = '/art/welcome-title-tm-v215.webp'; title.fetchPriority = 'high'; 