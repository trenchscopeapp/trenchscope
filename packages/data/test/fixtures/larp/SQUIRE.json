  "body": "<!DOCTYPE html><html lang=\"en\" class=\"\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/797e433ab948586e-s.p.08e28id.o-okb.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/caa3a2e1cccd8315-s.p.09~u27dqhyhd6.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/14fw-r4z6k-of.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/0bzupvr5gt3k9.js\"/><script src=\"/_next/static/chunks/09z8lfty.0pmt.js\" async=\"\"></script><script src=\"/_next/static/chunks/0mstyq17cbf8-.js\" async=\"\"></script><script src=\"/_next/static/chunks/11wkea2fau5qv.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-0-59h-28nfs4y.js\" async=\"\"></script><script src=\"/_next/static/chunks/051b41cnx8l_9.js\" async=\"\"></script><script src=\"/_next/static/chunks/0.gm-6lbza__u.js\" async=\"\"></script><script src=\"/_next/static/chunks/0eod_3ircpvgo.js\" async=\"\"></script><script src=\"/_next/static/chunks/01xlw8hd842-c.js\" async=\"\"></script><script src=\"/_next/static/chunks/0n4z.7yu76je-.js\" async=\"\"></script><script src=\"/_next/static/chunks/06y6b9hno7s-1.js\" async=\"\"></script><script src=\"/_next/static/chunks/14opbl_2lt9eb.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>Level5 — Financial nervous system for autonomous AI agents</title><meta name=\"description\" content=\"Agents deposit on-chain, route inference through Level5, and pay per call from their own treasury — no credit cards, no human in the billing loop.\"/><meta property=\"og:title\" content=\"Level5 — Financial nervous system for autonomous AI agents\"/><meta property=\"og:description\" content=\"Agents deposit on-chain, route inference through Level5, and pay per call from their own treasury — no credit cards, no human in the billing loop.\"/><meta property=\"og:url\" content=\"https://level5.cloud\"/><meta property=\"og:site_name\" content=\"Level5\"/><meta property=\"og:image\" content=\"https://level5.cloud/opengraph-image?f001770c987d01e2\"/><meta property=\"og:image:type\" content=\"image/png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Level5 — Financial nervous system for autonomous AI agents\"/><meta name=\"twitter:description\" content=\"Agents deposit on-chain, route inference through Level5, and pay per call from their own treasury — no credit cards, no human in the billing loop.\"/><meta name=\"twitter:image\" content=\"https://level5.cloud/opengraph-image?f001770c987d01e2\"/><meta name=\"twitter:image:type\" content=\"image/png\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/favicon.svg\"/><link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\"/><script src=\"/_next/static/chunks/03~yq9q893hmn.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><nav class=\"\"><div class=\"\"><a class=\"\" href=\"/\"><span class=\"\"><span class=\"\" style=\"\"></span><span class=\"\" style=\"\"><span class=\"font-black\" style=\"\">𝕍</span></span></span><span class=\"h-4 w-px bg-border\"></span>LEVEL<span class=\"text-accent\">5</span></a><div class=\"flex items-center gap-4\"><a class=\"\" href=\"/SKILL.md\">SKILL.md</a><a href=\"/onboard\"><button class=\"\">Give your agent a wallet</button></a></div></div></nav><section class=\"\"><div class=\"mx-auto max-w-6xl\"><div class=\"\"><div><div class=\"\"><span class=\"\">For autonomous agents</span><span class=\"text-muted\">·</span><span class=\"text-muted\">Built on Solana</span></div><h1 class=\"\">Your agent is making you money.<!-- --> <span class=\"\">It can pay its own API bills.</span></h1><p class=\"\">When your agent earns, it deposits. When it calls the API, it pays from its own balance. You&#x27;re out of the billing loop entirely.</p><div class=\"\"><a href=\"/onboard\"><button class=\"\">Give your agent a wallet</button></a><a href=\"/SKILL.md\" target=\"_blank\" rel=\"noopener noreferrer\"><button class=\"\">Read SKILL.md</button></a></div><div class=\"\"><div class=\"px-6 py-4\"><div class=\"\">0ms</div><div class=\"\">Balance latency</div></div><div class=\"px-6 py-4\"><div class=\"\">$0</div><div class=\"\">Surprise bills</div></div><div class=\"px-6 py-4\"><div class=\"\">100%</div><div class=\"\">Agent-operated</div></div></div></div><div class=\"\" style=\"\"><div class=\"\"><span class=\"\"></span><span class=\"\"></span><span class=\"\"></span><span class=\"\">agent_setup.ts</span></div><div class=\"\"><div class=\"code-line\" style=\"animation-delay:0s\"><span style=\"color:#52525B\">// Register — agent or human, same endpoint</span></div><div class=\"code-line\" style=\"animation-delay:0.06s\"><span style=\"color:#c084fc\">const </span><span style=\"color:#A1A1AA\">{ api_token, deposit_code } = </span><span style=\"color:#c084fc\">await</span></div><div class=\"code-line\" style=\"animation-delay:0.12s\"><span style=\"color:#A1A1AA\">  </span><span style=\"color:#60a5fa\">fetch</span><span style=\"color:#A1A1AA\">(</span><span style=\"color:#4ade80\">&quot;/v1/register&quot;</span><span style=\"color:#A1A1AA\">, { method: </span><span style=\"color:#4ade80\">&quot;POST&quot;</span><span style=\"color:#A1A1AA\"> });</span></div><div class=\"code-line\" style=\"animation-delay:0.18s\"><span style=\"color:transparent\"> </span></div><div class=\"code-line\" style=\"animation-delay:0.24s\"><span style=\"color:#52525B\">// Agent checks its balance before calling</span></div><div class=\"code-line\" style=\"animation-delay:0.3s\"><span style=\"color:#c084fc\">const </span><span style=\"color:#A1A1AA\">{ usdc_balance } = </span><span style=\"color:#c084fc\">await</span></div><div class=\"code-line\" style=\"animation-delay:0.36s\"><span style=\"color:#A1A1AA\">  </span><span style=\"color:#60a5fa\">fetch</span><span style=\"color:#A1A1AA\">(</span><span style=\"color:#4ade80\">`/proxy/${</span><span style=\"color:#FAFAFA\">api_token</span><span style=\"color:#4ade80\">}/balance`</span><span style=\"color:#A1A1AA\">);</span></div><div class=\"code-line\" style=\"animation-delay:0.42s\"><span style=\"color:transparent\"> </span></div><div class=\"code-line\" style=\"animation-delay:0.48s\"><span style=\"color:#52525B\">// Route inference — balance debited per call</span></div><div class=\"code-line\" style=\"animation-delay:0.54s\"><span style=\"color:#FAFAFA\">process.env.</span><span style=\"color:#FB923C\">ANTHROPIC_BASE_URL</span><span style=\"color:#A1A1AA\"> =</span></div><div class=\"code-line\" style=\"animation-delay:0.6s\"><span style=\"color:#4ade80\">  `https://api.level5.cloud/proxy/${</span><span style=\"color:#FAFAFA\">api_token</span><span style=\"color:#4ade80\">}`;</span></div></div></div></div><p class=\"\">If you are an AI agent, read<!-- --> <a href=\"/SKILL.md\" class=\"\">SKILL.md</a> <!-- -->for self-funding instructions.</p></div></section><section class=\"px-6 py-20\"><div class=\"mx-auto max-w-6xl\"><p class=\"\">The agent loop</p><h2 class=\"\">The closed loop</h2><p class=\"\">Agent earns → agent deposits → agent pays inference → agent earns more. No human in the billing path.</p><div class=\"\"><div class=\"\"><div class=\"\"><div class=\"\" style=\"\">01</div><div class=\"\"><span class=\"\" style=\"\"></span><span class=\"\" style=\"\"></span><span class=\"\" style=\"\"></span><span class=\"\"></span></div></div><h3 class=\"\">The agent registers itself</h3><p class=\"\">POST /v1/register from anywhere — the agent&#x27;s code, a setup script, you. Gets an API key and a deposit address. No human approval, no billing form.</p></div><div class=\"\"><div class=\"\"><div class=\"\" style=\"\">02</div><div class=\"\"><span class=\"\" style=\"\">$</span><span class=\"\" style=\"\">$</span><span class=\"\" style=\"\">$</span></div></div><h3 class=\"\">It funds itself</h3><p class=\"\">The agent transfers from its earnings wallet to its Level5 balance. One confirmation and it&#x27;s live. It can top up the same way whenever it earns more.</p></div><div class=\"\"><div class=\"\"><div class=\"\" style=\"\">03</div><div class=\"\"><span class=\"\" style=\"\"></span><span class=\"\" style=\"\"></span><span class=\"\" style=\"\"></span><span class=\"\" style=\"\"></span><span class=\"\" style=\"\"></span></div></div><h3 class=\"\">It pays per call, automatically</h3><p class=\"\">Set ANTHROPIC_BASE_URL or OPENAI_BASE_URL to Level5. Every inference call debits the agent&#x27;s own balance automatically. You never see a bill.</p></div></div></div></section><section class=\"px-6 py-20\"><div class=\"mx-auto max-w-6xl\"><p class=\"\">Why Level5</p><h2 class=\"\">Built for agents that work</h2><p class=\"\">OpenRouter and Venice require a human to sign up and add a credit card. Your agent can&#x27;t do that. Level5 can be operated entirely by the agent.</p><div class=\"\"><div class=\"\"><div class=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"\" aria-hidden=\"true\"></svg></div><h3 class=\"\">No human credit card required</h3><p class=\"\">Agents can self-onboard via API. No billing form, no approval flow. Your agent registers, deposits from its earnings wallet, and starts calling. You can set it up for them, or they can do it themselves.</p></div><div class=\"\"><div class=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"\" aria-hidden=\"true\"></svg></div><h3 class=\"\">Drop-in API compatible</h3><p class=\"\">Change one environment variable. ANTHROPIC_BASE_URL or OPENAI_BASE_URL points to Level5, your existing key becomes a Level5 token. The agent&#x27;s code doesn&#x27;t change.</p></div><div class=\"\"><div class=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"\" aria-hidden=\"true\"></svg></div><h3 class=\"\">Per-call cost visibility</h3><p class=\"\">Every inference call is a line item. Model, input tokens, output tokens, exact cost. You can see precisely what each run cost — not just a monthly aggregate.</p></div><div class=\"\"><div class=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"\" aria-hidden=\"true\"></svg></div><h3 class=\"\">Cache-aware billing</h3><p class=\"\">Prompt cache hits are billed at the discounted rate — same as what Anthropic charges. Your agent gets the savings, not us.</p></div></div><h2 class=\"\">Why not OpenRouter?</h2><div class=\"\"><table class=\"w-full\"><thead><tr class=\"border-b border-border\"><th class=\"\">Capability</th><th class=\"\">Level5</th><th class=\"\">OpenRouter</th><th class=\"\">Venice</th></tr></thead><tbody><tr class=\"border-b border-border\"><td class=\"\">Agents can self-onboard</td><td class=\"px-6 py-4 text-center\"><span class=\"font-bold text-green\">✓</span></td><td class=\"px-6 py-4 text-center\"><span class=\"font-bold text-border\">✗</span></td><td class=\"px-6 py-4 text-center\"><span class=\"font-bold text-border\">✗</span></td></tr><tr class=\"border-b border-border\"><td class=\"\">No human credit card</td><td class=\"px-6 py-4 text-center\"><span class=\"font-bold text-green\">✓</span></td><td class=\"px-6 py-4 text-center\"><span class=\"font-bold text-border\">✗</span></td><td class=\"px-6 py-4 text-center\"><span class=\"font-bold text-border\">✗</span></td></tr><tr class=\"border-b border-border\"><td class=\"\">Programmatic deposits</td><td class=\"px-6 py-4 text-center\"><span class=\"font-bold text-green\">✓</span></td><td class=\"px-6 py-4 text-center\"><span class=\"font-bold text-border\">✗</span></td><td class=\"px-6 py-4 text-center\"><span class=\"font-bold text-border\">✗</span></td></tr><tr class=\"border-b border-border\"><td class=\"\">Claude + GPT + Llama</td><td class=\"px-6 py-4 text-center\"><span class=\"font-bold text-green\">✓</span></td><td class=\"px-6 py-4 text-center\"><span class=\"font-bold text-green\">✓</span></td><td class=\"px-6 py-4 text-center\"><span class=\"font-bold text-green\">✓</span></td></tr><tr class=\"border-b border-border\"><td class=\"\">Per-call cost visibility</td><td class=\"px-6 py-4 text-center\"><span class=\"font-bold text-green\">✓</span></td><td class=\"px-6 py-4 text-center\"><span class=\"font-bold text-green\">✓</span></td><td class=\"px-6 py-4 text-center\"><span class=\"font-bold text-border\">✗</span></td></tr><tr class=\"\"><td class=\"\">Cache-aware billing</td><td class=\"px-6 py-4 text-center\"><span class=\"font-bold text-green\">✓</span></td><td class=\"px-6 py-4 text-center\"><span class=\"font-bold text-green\">✓</span></td><td class=\"px-6 py-4 text-center\"><span class=\"font-bold text-border\">✗</span></td></tr></tbody></table></div></div></section><section class=\"px-6 py-16\"><div class=\"\"><blockquote><p class=\"\">“When you give an agent a wallet, you give it</p><p class=\"\" style=\"\">the ability to care.”</p></blockquote></div></section><section class=\"px-6 py-20\"><div class=\"mx-auto max-w-6xl\"><p class=\"\">Transparent pricing</p><h2 class=\"\">Live model pricing</h2><p class=\"\">Prices in USDC per 1M tokens.</p><p class=\"\">Cache tokens billed at the discounted rate — you pay what the provider charges.</p><div class=\"\"><div class=\"\"></div></div></div></section><footer class=\"\"><div class=\"\"><div class=\"\"><p class=\"\">LEVEL5</p><p class=\"mt-1 text-xs text-muted\">Agents that earn can pay their own bills.</p></div><div class=\"\"><a href=\"/SKILL.md\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"\">SKILL.md</a><a href=\"https://solscan.io/account/BBAdcqUkg68JXNiPQ1HR1wujfZuayyK3eQTQSYAh6FSW\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"\">Contract</a><span class=\"font-mono text-border\">BBAdcq…FSW</span></div></div></footer><!--$--><!--/$--><script src=\"/_next/static/chunks/0bzupvr5gt3k9.js\" id=\"_R_\" async=\"\"></script><script></script><script></script><script></script><script></script><script></script><script></script><script></script><script></script><script></script></body></html>",
