  "contentType": "text/html; charset=utf-8",
  "body": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Ultraviolet — Solana, at a higher frequency</title>\n  <meta name=\"description\" content=\"Ultraviolet is a Solana L2 for token launches: a ZK rollup with instant pre-confirmations, every batch proven and settled on Solana. Launch on a bonding curve, trade, and graduate to a pool on the L2.\">\n  <meta name=\"theme-color\" content=\"#05040A\">\n  <link rel=\"canonical\" href=\"https://www.ultravioletnetwork.com/\">\n  <meta property=\"og:title\" content=\"Ultraviolet — Solana, at a higher frequency\">\n  <meta property=\"og:description\" content=\"The Solana L2 for token launches. A ZK rollup, proven and settled on Solana.\">\n  <meta property=\"og:url\" content=\"https://www.ultravioletnetwork.com/\">\n  <meta property=\"og:image\" content=\"https://www.ultravioletnetwork.com/brand/assets/png/og-image.png?v=3\">\n  <meta name=\"twitter:card\" content=\"summary_large_image\">\n  <link rel=\"icon\" href=\"brand/assets/favicon.svg\" type=\"image/svg+xml\">\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n<!-- ==================================================================\n     Every value on this page traces to brand/01-brand-foundation.md § Fact sheet\n     (derived from ultraviolet-l2/). Timings marked \"Measuring\" have no published\n     figure yet. Shared values live in the SPEC object at the top of main.js.\n     Brand files in site/brand are synced copies — run ./sync-brand.sh.\n     ================================================================== -->\n\n<div class=\"frame\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i></div>\n<div class=\"grain\" aria-hidden=\"true\"></div>\n\n<header class=\"nav\">\n  <div class=\"nav__inner\">\n    <a href=\"#top\" class=\"nav__logo\" aria-label=\"Ultraviolet home\">\n      <img src=\"brand/assets/lockup.svg\" alt=\"Ultraviolet\" width=\"190\" height=\"28\">\n    </a>\n    <div class=\"nav__hud\" aria-hidden=\"true\">\n      <span>λ <b id=\"hudLambda\">400.0</b> nm</span>\n      <span>f <b id=\"hudFreq\">749.5</b> <i id=\"hudFreqUnit\">THz</i></span>\n      <span>E <b id=\"hudEnergy\">3.10</b> eV</span>\n    </div>\n    <nav class=\"nav__links\" aria-label=\"Primary\">\n      <a href=\"#thesis\">Thesis</a>\n      <a href=\"#architecture\">Architecture</a>\n      <a href=\"#build\">How it works</a>\n      <a href=\"#spec\">Datasheet</a>\n      <a href=\"docs/\">Docs</a>\n    </nav>\n    <a href=\"https://app.ultravioletnetwork.com\" class=\"\">Launch app <span aria-hidden=\"true\">→</span></a>\n  </div>\n</header>\n\n<!-- Spectral index: a scroll-linked wavelength rail (desktop) -->\n<aside class=\"rail\" aria-label=\"Section index\">\n  <ol class=\"rail__stops\" id=\"railStops\"></ol>\n  <div class=\"rail__marker\" id=\"railMarker\" aria-hidden=\"true\"><i></i></div>\n</aside>\n\n<main>\n\n  <!-- 01 · λ 400 — HERO ---------------------------------------------- -->\n  <section class=\"hero grainy\" id=\"top\" data-lambda=\"400\" data-name=\"Signal\">\n    <div class=\"grain-fx grain-fx--glow\" aria-hidden=\"true\" style=\"\"></div>\n    <div class=\"wrap\">\n      <div class=\"hero__meta\">\n        <span class=\"pill\"><i class=\"px\"></i>LAUNCHPAD LIVE</span>\n        <span>SOLANA L2</span>\n        <span>PROVEN ON SOLANA</span>\n        <span class=\"hide-sm\">ULTRAVIOLETNETWORK.COM</span>\n      </div>\n\n      <h1 class=\"hero__title display\" aria-label=\"Solana, at a higher frequency.\">\n        <span class=\"line\"><span>Solana,</span></span>\n        <span class=\"line line--outline\"><span>at a higher</span></span>\n        <span class=\"line line--grad\"><span>frequency.</span></span>\n      </h1>\n\n      <div class=\"hero__grid\">\n        <div class=\"hero__copy\">\n          <p class=\"hero__sub reveal\">Ultraviolet is a Solana L2 for token launches: a ZK rollup with instant pre-confirmations, every batch proven and settled on Solana. Launch on a bonding curve, trade, and graduate to a pool on the L2.</p>\n          <div class=\"hero__ctas reveal\">\n            <a href=\"https://app.ultravioletnetwork.com\" class=\"btn btn--primary\">Launch app <span aria-hidden=\"true\">→</span></a>\n            <a href=\"https://app.ultravioletnetwork.com/explorer/\" class=\"btn btn--ghost\">Spectrometer</a>\n          </div>\n          <div class=\"ca reveal\" aria-label=\"$UV contract address\">\n            <span class=\"ca__k\"><i class=\"px\"></i>$UV · CA</span>\n            <code class=\"ca__v\">2gLnaQN8Y73Qc62gMmX6WtJQjFnbvE7vgzUJ37WJpump</code>\n            <button type=\"button\" class=\"ca__copy\" data-copy=\"2gLnaQN8Y73Qc62gMmX6WtJQjFnbvE7vgzUJ37WJpump\">Copy</button>\n            <a class=\"ca__link\" href=\"https://pump.fun/coin/2gLnaQN8Y73Qc62gMmX6WtJQjFnbvE7vgzUJ37WJpump\" target=\"_blank\" rel=\"noopener\">pump.fun <span aria-hidden=\"true\">↗</span></a>\n          </div>\n          <dl class=\"readouts reveal\" aria-label=\"Protocol facts\">\n            <div><dt>Trading fee</dt><dd><b data-spec=\"feePct\">0.25</b><small>%</small></dd><span>per trade</span></div>\n            <div><dt>To buyback</dt><dd><b data-spec=\"burnPct\">100</b><small>%</small></dd><span>burns $UV</span></div>\n            <div><dt>Proofs</dt><dd><b>ZK</b></dd><span>RISC Zero</span></div>\n            <div><dt>Settles to</dt><dd><b>Solana</b></dd><span>L1 mainnet</span></div>\n          </dl>\n        </div>\n\n        <figure class=\"instrument reveal\" id=\"prismFig\">\n          <div class=\"instrument__bar\">\n            <span>FIG. 01 — DISPERSION</span>\n            <span class=\"instrument__read\" aria-live=\"off\">\n              λ <b id=\"pLambda\">365.0</b> nm <i>·</i> f <b id=\"pFreq\">821.3</b> THz <i>·</i> E <b id=\"pE\">3.40</b> eV <i>·</i> <b id=\"pBand\" class=\"band-tag\">UV-A</b>\n            </span>\n          </div>\n          <canvas id=\"prism\" aria-label=\"Animated diagram: Solana's violet light passes through a prism and disperses into the ultraviolet bands UV-A, UV-B and UV-C.\" role=\"img\"></canvas>\n          <figcaption class=\"instrument__foot\">\n            <span>IN · SOLANA L1 · VISIBLE VIOLET</span>\n            <span>OUT · ULTRAVIOLET · 400 → 100 NM</span>\n            <span class=\"hint\">◎ MOVE TO PROBE</span>\n          </figcaption>\n        </figure>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"marquee\" aria-hidden=\"true\">\n    <div class=\"marquee__track\">\n      <span>Launch</span><i></i><span>Trade</span><i></i><span>Graduate</span><i></i><span class=\"hi\">Proven on Solana</span><i></i><span>0.25% fee</span><i></i><span>100% buyback and burn</span><i></i><span>λ 400 → 13.5 nm</span><i></i>\n      <span>Launch</span><i></i><span>Trade</span><i></i><span>Graduate</span><i></i><span class=\"hi\">Proven on Solana</span><i></i><span>0.25% fee</span><i></i><span>100% buyback and burn</span><i></i><span>λ 400 → 13.5 nm</span><i></i>\n    </div>\n  </div>\n\n  <!-- 02 · λ 365 — THESIS --------------------------------------------- -->\n  <section class=\"section grainy\" id=\"thesis\" data-lambda=\"365\" data-name=\"Thesis\">\n    <div class=\"glow-pool\" aria-hidden=\"true\" style=\"\"></div>\n    <div class=\"grain-fx grain-fx--glow\" aria-hidden=\"true\" style=\"\"></div>\n    <div class=\"wrap sechead\">\n      <div class=\"sechead__side\">\n        <p class=\"eyebrow\"><span class=\"idx\">02</span><span class=\"scr\">λ 365 NM — THESIS</span></p>\n        <p class=\"side-note\">ABSTRACT<br><span>Read as you scroll.</span></p>\n      </div>\n      <p class=\"statement\" id=\"statement\">Solana got the base layer right. Launches need their own loop: instant pre-confirmations, the same rules for everyone, a guaranteed way out. Ultraviolet is that loop. Not a fork. Not a rival. The <em>next wavelength</em> of the same chain.</p>\n    </div>\n  </section>\n\n  <!-- 03 · λ 315 — FREQUENCY ----------------------------------------- -->\n  <section class=\"section grainy\" id=\"frequency\" data-lambda=\"315\" data-name=\"Frequency\">\n    <div class=\"glow-pool\" aria-hidden=\"true\" style=\"\"></div>\n    <div class=\"grain-fx grain-fx--glow\" aria-hidden=\"true\" style=\"\"></div>\n    <div class=\"wrap\">\n      <div class=\"sechead\">\n        <div class=\"sechead__side\"><p class=\"eyebrow\"><span class=\"idx\">03</span><span class=\"scr\">λ 315 NM — FREQUENCY</span></p></div>\n        <div>\n          <div class=\"wipe-box\"><h2 class=\"h2 display wipe\">Trade instantly.<br>Settle with a proof.</h2></div>\n          <p class=\"body reveal\">Trades are pre-confirmed the moment you sign. They're grouped into batches of up to 16 commands, each batch is proven with RISC Zero, and the proof is verified on Solana.</p>\n        </div>\n      </div>\n      <figure class=\"scope reveal\">\n        <div class=\"instrument__bar\">\n          <span>FIG. 02 — OSCILLOSCOPE</span>\n          <span>ILLUSTRATIVE <i>·</i> NOT TO SCALE</span>\n        </div>\n        <canvas id=\"scope\" role=\"img\" aria-label=\"Oscilloscope illustration: channel 1 shows batches being proven and settled on Solana; channel 2 shows trades pre-confirmed on Ultraviolet, up to sixteen per batch. Not to scale.\"></canvas>\n        <div class=\"scope__legend\">\n          <span class=\"ch1\"><i></i>CH1 BATCHES · PROVEN ON SOLANA · batch <b id=\"ch1n\">1</b></span>\n          <span class=\"ch2\"><i></i>CH2 TRADES · PRE-CONFIRMED · <b id=\"ch2n\">0</b> / <span data-spec=\"batchCommands\">16</span> in this batch</span>\n        </div>\n      </figure>\n    </div>\n  </section>\n\n  <!-- 04 · λ 280 — PRINCIPLES ---------------------------------------- -->\n  <section class=\"section\" id=\"principles\" data-lambda=\"280\" data-name=\"Principles\">\n    <div class=\"wrap\">\n      <div class=\"sechead\">\n        <div class=\"sechead__side\"><p class=\"eyebrow\"><span class=\"idx\">04</span><span class=\"scr\">λ 280 NM — PRINCIPLES</span></p></div>\n        <div class=\"wipe-box\"><h2 class=\"h2 display wipe\">Built from Solana.<br>Tuned for <span class=\"nw\">real-time.</span></h2></div>\n      </div>\n      <ol class=\"rows\">\n        <li class=\"row reveal\">\n          <span class=\"row__idx\">01</span>\n          <h3 class=\"row__title display\">Frequency</h3>\n          <p>Trades are pre-confirmed the moment you sign, in a loop that runs above Solana. Built for brand-new tokens that move fast.</p>\n          <span class=\"row__meta\">PRE-CONFIRMED</span>\n        </li>\n        <li class=\"row reveal\">\n          <span class=\"row__idx\">02</span>\n          <h3 class=\"row__title display\">Proven</h3>\n          <p>Every batch carries a RISC Zero validity proof, Groth16-verified on Solana. Correct execution is checked, not assumed.</p>\n          <span class=\"row__meta\">ZK = RISC ZERO</span>\n        </li>\n        <li class=\"row reveal\">\n          <span class=\"row__idx\">03</span>\n          <h3 class=\"row__title display\">Aligned</h3>\n          <p>Native SOL in and out, custody in a Solana program, and every batch's data published on Solana. If the sequencer ever censors you, the Solana inbox forces you in.</p>\n          <span class=\"row__meta\">L1 = SOLANA</span>\n        </li>\n        <li class=\"row reveal\">\n          <span class=\"row__idx\">04</span>\n          <h3 class=\"row__title display\">Burn</h3>\n          <p>0.25% per trade. 100% of protocol fees buy back and burn the parent token. Fees have one job.</p>\n          <span class=\"row__meta\">FEE → BURN</span>\n        </li>\n      </ol>\n    </div>\n  </section>\n\n  <!-- 05 · λ 254 — ARCHITECTURE -------------------------------------- -->\n  <section class=\"section\" id=\"architecture\" data-lambda=\"254\" data-name=\"Architecture\">\n    <div class=\"wrap arch\">\n      <div class=\"arch__text\">\n        <p class=\"eyebrow\"><span class=\"idx\">05</span><span class=\"scr\">λ 254 NM — ARCHITECTURE</span></p>\n        <div class=\"wipe-box\"><h2 class=\"h2 display wipe\">Execute above.<br>Settle below.</h2></div>\n        <p class=\"body reveal\">Launches and trades execute on Ultraviolet's launchpad state machine and are pre-confirmed instantly. Each batch is proven with RISC Zero, its data is published on Solana, and the proof is verified by the custody program on Solana.</p>\n        <ol class=\"layers reveal\" id=\"layerList\">\n          <li data-layer=\"apps\"><span>L3</span><b>Launchpad &amp; Spectrometer</b><em>Launch, trade, graduate. Read every batch.</em></li>\n          <li data-layer=\"uv\"><span>L2</span><b>Ultraviolet</b><em>Sequencer + launchpad state machine. Instant pre-confirmations.</em></li>\n          <li data-layer=\"proof\"><span>Π</span><b>Validity proofs</b><em>RISC Zero zkVM, Groth16-verified on Solana.</em></li>\n          <li data-layer=\"l1\"><span>L1</span><b>Solana</b><em>Custody, data availability, settlement.</em></li>\n        </ol>\n      </div>\n      <figure class=\"arch__fig\" id=\"isoFig\">\n        <svg id=\"iso\" viewBox=\"0 0 760 640\" role=\"img\" aria-label=\"Isometric diagram of four stacked layers: apps, Ultraviolet, proofs, and Solana L1 at the base, with transactions flowing down to settlement.\"></svg>\n        <figcaption>FIG. 03 — LAYER STACK</figcaption>\n      </figure>\n    </div>\n  </section>\n\n  <!-- 06 · λ 185 — BUILD --------------------------------------------- -->\n  <section class=\"section\" id=\"build\" data-lambda=\"185\" data-name=\"How it works\">\n    <div class=\"wrap split\">\n      <div>\n        <p class=\"eyebrow\"><span class=\"idx\">06</span><span class=\"scr\">λ 185 NM — HOW IT WORKS</span></p>\n        <div class=\"wipe-box\"><h2 class=\"h2 display wipe\">Launch. Trade.<br>Graduate.</h2></div>\n        <p class=\"body reveal\">Every token follows the same lifecycle, with the same rules for everyone, enforced by the proof.</p>\n        <ul class=\"checks reveal\">\n          <li><i class=\"px\"></i>Sign with your Solana wallet</li>\n          <li><i class=\"px\"></i>Native SOL in, native SOL out</li>\n          <li><i class=\"px\"></i>Forced inclusion if the sequencer censors</li>\n        </ul>\n      </div>\n      <div class=\"term reveal\">\n        <div class=\"term__bar\">\n          <span class=\"term__dots\"><i></i><i></i><i></i></span>\n          <span>token lifecycle</span>\n        </div>\n        <ol class=\"flow\">\n          <li><span>01</span><b>Deposit</b><em>Native SOL into the custody program on Solana.</em></li>\n          <li><span>02</span><b>Launch</b><em>Fixed supply. All of it starts on the bonding curve.</em></li>\n          <li><span>03</span><b>Trade</b><em>Buy and sell on the curve, pre-confirmed instantly. 0.25% per trade.</em></li>\n          <li><span>04</span><b>Graduate</b><em>At the threshold, reserves form a constant-product pool on the L2. Creators can't withdraw pool liquidity.</em></li>\n          <li><span>05</span><b>Withdraw</b><em>Once the batch settles on Solana, claim your SOL in one transaction.</em></li>\n        </ol>\n      </div>\n    </div>\n  </section>\n\n  <!-- 07 · λ 121 — DATASHEET ----------------------------------------- -->\n  <section class=\"section\" id=\"spec\" data-lambda=\"121\" data-name=\"Datasheet\">\n    <div class=\"wrap\">\n      <div class=\"sechead\">\n        <div class=\"sechead__side\"><p class=\"eyebrow\"><span class=\"idx\">07</span><span class=\"scr\">λ 121 NM — DATASHEET</span></p></div>\n        <div>\n          <div class=\"wipe-box\"><h2 class=\"h2 display wipe\">What's confirmed.<br>What we're measuring.</h2></div>\n          <p class=\"body reveal\">Every value traces to the code. Timings are published once they're measured on mainnet.</p>\n        </div>\n      </div>\n\n      <article class=\"ds reveal\" aria-label=\"Ultraviolet datasheet\">\n        <header class=\"ds__head\">\n          <div>\n            <span class=\"ds__brand display\">Ultraviolet</span>\n            <span class=\"ds__part\">UV-1 · LAUNCHPAD ROLLUP ON SOLANA</span>\n          </div>\n          <div class=\"ds__rev\">DATASHEET<br>REV 1.0<br>OCT 2026</div>\n        </header>\n        <div class=\"ds__cols\">\n          <section>\n            <h4>1 · Features</h4>\n            <ul>\n              <li>Bonding-curve launches that graduate to a constant-product pool</li>\n              <li>Instant pre-confirmations from the sequencer</li>\n              <li>RISC Zero validity proofs, Groth16-verified on Solana</li>\n              <li>Batch data published on Solana</li>\n              <li>Forced inclusion through the Solana inbox</li>\n            </ul>\n          </section>\n          <section>\n            <h4>2 · Description</h4>\n            <p>UV-1 is a purpose-built launchpad rollup. It sequences and executes launches, trades, transfers and withdrawals on its own state machine, proves each batch with RISC Zero, publishes the batch data on Solana and settles to a custody program on Solana mainnet. 100% of protocol fees buy back and burn the parent token.</p>\n          </section>\n        </div>\n        <h4 class=\"ds__h\">3 · Characteristics</h4>\n        <div class=\"ds__tablewrap\">\n          <table class=\"ds__table\">\n            <thead>\n              <tr><th>Parameter</th><th class=\"opt\">Symbol</th><th class=\"opt\">Min</th><th>Typ</th><th class=\"opt\">Max</th><th>Unit</th><th>Status</th></tr>\n            </thead>\n            <tbody>\n              <tr><td>Execution</td><td class=\"opt\">—</td><td class=\"opt\">—</td><td>Launchpad state machine</td><td class=\"opt\">—</td><td>—</td><td><span class=\"st st--ok\">Confirmed</span></td></tr>\n              <tr><td>Settlement layer</td><td class=\"opt\">L1</td><td class=\"opt\">—</td><td>Solana mainnet</td><td class=\"opt\">—</td><td>—</td><td><span class=\"st st--ok\">Confirmed</span></td></tr>\n              <tr><td>Proof system</td><td class=\"opt\">Π</td><td class=\"opt\">—</td><td>RISC Zero zkVM 3.0.6 → Groth16</td><td class=\"opt\">—</td><td>—</td><td><span class=\"st st--ok\">Confirmed</span></td></tr>\n              <tr><td>Data availability</td><td class=\"opt\">DA</td><td class=\"opt\">—</td><td>Solana</td><td class=\"opt\">8</td><td>KB / batch</td><td><span class=\"st st--ok\">Confirmed</span></td></tr>\n              <tr><td>Batch capacity</td><td class=\"opt\">n<sub>cmd</sub></td><td class=\"opt\">—</td><td>≤ <span data-spec=\"batchCommands\">16</span></td><td class=\"opt\">16</td><td>commands</td><td><span class=\"st st--ok\">Confirmed</span></td></tr>\n              <tr><td>Quote asset</td><td class=\"opt\">—</td><td class=\"opt\">—</td><td>Native SOL</td><td class=\"opt\">—</td><td>—</td><td><span class=\"st st--ok\">Confirmed</span></td></tr>\n              <tr><td>Trading fee</td><td class=\"opt\">f</td><td class=\"opt\">—</td><td data-spec=\"feePct\">0.25</td><td class=\"opt\">—</td><td>%</td><td><span class=\"st st--ok\">Confirmed</span></td></tr>\n              <tr><td>Fees to buyback &amp; burn</td><td class=\"opt\">—</td><td class=\"opt\">—</td><td data-spec=\"burnPct\">100</td><td class=\"opt\">—</td><td>%</td><td><span class=\"st st--ok\">Confirmed</span></td></tr>\n              <tr><td>Sequencer</td><td class=\"opt\">SEQ</td><td class=\"opt\">—</td><td>Single + forced inclusion</td><td class=\"opt\">—</td><td>—</td><td><span class=\"st st--ok\">Confirmed</span></td></tr>\n              <tr><td>Trade pre-confirmation</td><td class=\"opt\">—</td><td class=\"opt\">—</td><td>—</td><td class=\"opt\">—</td><td>—</td><td><span class=\"st st--target\">Measuring<sup>1</sup></span></td></tr>\n              <tr><td>Settlement per batch</td><td class=\"opt\">—</td><td class=\"opt\">—</td><td>—</td><td class=\"opt\">—</td><td>—</td><td><span class=\"st st--target\">Measuring<sup>1</sup></span></td></tr>\n            </tbody>\n          </table>\n        </div>\n        <p class=\"ds__notes\">Notes: (1) Measuring = running on mainnet; we publish the figure with its methodology once measured. (2) Specifications subject to change without notice.</p>\n      </article>\n    </div>\n  </section>\n\n  <!-- 08 · λ 50 — ROADMAP -------------------------------------------- -->\n  <section class=\"section\" id=\"roadmap\" data-lambda=\"50\" data-name=\"Roadmap\">\n    <div class=\"wrap\">\n      <div class=\"sechead\">\n        <div class=\"sechead__side\"><p class=\"eyebrow\"><span class=\"idx\">08</span><span class=\"scr\">λ 400 → 100 NM — ROADMAP</span></p></div>\n        <div class=\"wipe-box\"><h2 class=\"h2 display wipe\">Shorter wavelength.<br>More energy.</h2></div>\n      </div>\n\n      <div class=\"strip reveal\" aria-hidden=\"true\">\n        <div class=\"strip__bands\">\n          <span style=\"left:0;width:28.33%\">UV-A</span>\n          <span style=\"\">UV-B</span>\n          <span style=\"left:40%;width:60%\">UV-C</span>\n        </div>\n        <div class=\"strip__bar\" id=\"stripBar\">\n          <div class=\"strip__here\" style=\"left:12%\"><i></i><span>YOU ARE HERE</span></div>\n        </div>\n        <div class=\"strip__scale\">\n          <span style=\"left:0\">400</span><span style=\"left:16.67%\">350</span><span style=\"left:33.33%\">300</span><span style=\"left:50%\">250</span><span style=\"left:66.67%\">200</span><span style=\"left:83.33%\">150</span><span style=\"left:100%\">100 nm</span>\n        </div>\n      </div>\n\n      <ol class=\"stages\">\n        <li class=\"stage stage--now reveal\">\n          <div class=\"stage__top\"><span class=\"stage__code display\">UV-A</span><span class=\"pill\"><i class=\"px\"></i>NOW</span></div>\n          <span class=\"stage__nm\">315–400 nm</span>\n          <h3>Launch</h3>\n          <p>Launchpad and the Spectrometer explorer live. Launch, trade, gra