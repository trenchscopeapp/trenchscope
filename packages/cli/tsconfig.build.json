{
  // Publish build (task-1346): emits runnable ESM for every workspace package into packages/cli/dist/,
  // mirroring the repo layout (dist/packages/<pkg>/src/*.js) so runtime-relative paths keep working.
  // Run through scripts/build-dist.mjs, which also inlines @dexterm/* imports and copies assets.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "../..",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["../*/src/**/*.ts"],
  "exclude": ["../*/src/**/*.test.ts"]
}
